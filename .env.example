# =============================================================================
# ARIOT environment template
# Copy this file to `.env.local` and fill in any project-specific overrides.
# All env access flows through the Zod-validated `server/env.ts` module —
# never read `process.env.X` directly in source code.
# =============================================================================

# Public site URL — used for canonical URLs, sitemap, robots, and OG defaults.
# Defaults to http://localhost:3000 when unset (see server/env.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
